	libvartoolspipeline.la
libvartools_la_SOURCES = vartools.c
@PYTHON_USE_TRUE@libvartoolsrunpython_la_SOURCES = runpython.c runpython.h
@PYTHON_USE_TRUE@libvartoolsrunpython_la_CFLAGS = @PYTHON_CSPEC@ -O0
@PYTHON_USE_TRUE@libvartoolsrunpython_la_LDFLAGS = @PYTHON_LSPEC@
