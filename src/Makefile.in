#libvartoolsrunR_la_CFLAGS = @INCLUDER@
#libvartoolsrunR_la_LDFLAGS = @LIBR@

# Pipeline library: all vartools sources except main.c, plus pipeline_api.c.
# The vartools binary links against this library instead of re-compiling
# those sources, so every symbol is compiled exactly once.
PIPELINE_SOURCES = alarm.c aov.c aov_harm.c amoeba.c analytic.c binlc.c pdm.c ftp.c \
 matchedfilter.c matchedfilter_nfft.c vonneumann.c percentileratios.c beyondNsigma.c \
 slopestats.c codym.c codyq.c structurefunction.c drwfit.c runlength.c \
 binarylcio.c chi2rms.c copylc.c decorr.c detrendtfa.c doublelinklist.c \
 error.c fluxtomag.c getampthresh.c ifelse.c initcommands.c inputoutput.c \
 jstet.c killharm.c lombscargle.c mrqmin.c mysort.c nonlinfit.c nr.c \
 parsecommandline.c processcommand.c rescalesig.c runblsfixdurtc.c \
 runblsfixper.c runbls_sn.c sigclip.c starspot.c statistics.c svdcmp.c \
 sysrem.c transitmodel.c util.c transit.c GetBLSsignaltorednoise.c \
 autocorrelation.c fourierfilter.c injectharm.c dftclean.c injecttransit.c \
 saverestorelc.c saverestorelistdata.c outcolumns.c medianfilter.c \
 findblends.c microlens.c fittrap.c addnoise.c example.c parseinputlist.c \
 parselc.c converttime.c userlib.c linfit.c help.c resample.c \
 restricttimes.c mcmcfit.c wwz.c callrunpython.c callrunR.c fft.c \
 matchcommand.c pipeline_api.c \
 analytic.h functions.h nonlinfit.h userlib.h binarylcio.h ifelse.h \
 outcolumn.h vartools_functionpointers.h commands.h vt_param_macros.h \
 mcmcfit.h programdata.h \
 vartools.h doublelinklist.h mysort.h userfunc.h statistics.h OutText.h

libvartoolspipeline_la_SOURCES = $(PIPELINE_SOURCES)
libvartoolspipeline_la_CPPFLAGS = $(INCLUDECFITSIO) $(INCLUDECSPICE) \
 $(LTDLINCL) \
 -D VARTOOLSLIB_USERLIBSDIR=\"$(USERLIBSDIR)\" \
 -D VARTOOLSLIB_USERFUNCSDIR=\"$(USERFUNCSDIR)\"

libvartoolspipeline_la_LDFLAGS = -version-info 1:0:0
libvartoolspipeline_la_LIBADD = libvartools.la $(LIBCFITSIO) $(LIBGSL) \
	$(LIBNFFT) $(LIBPTHREAD) $(LIBCSPICE) $(LIBLTDL) \
	$(am__append_3) $(am__append_5)
libvartoolspipeline_la_DEPENDENCIES = libvartools.la $(am__append_4) \
	$(am__append_6)
vartools_SOURCES = main.c \
 analytic.h functions.h nonlinfit.h userlib.h binarylcio.h ifelse.h \
 outcolumn.h vartools_functionpointers.h commands.h vt_param_macros.h \
 mcmcfit.h programdata.h \
 vartools.h doublelinklist.h mysort.h userfunc.h statistics.h OutText.h

vartools_CPPFLAGS = $(INCLUDECFITSIO) $(INCLUDECSPICE) $(LTDLINCL) -D VARTOOLSLIB_USERLIBSDIR=\"$(USERLIBSDIR)\" -D VARTOOLSLIB_USERFUNCSDIR=\"$(USERFUNCSDIR)\"
vartools_LDADD = libvartoolspipeline.la libvartools.la $(am__append_7) \
	$(am__append_9) $(LIBCFITSIO) $(LIBGSL) $(LIBNFFT) \
	$(LIBPTHREAD) $(LIBCSPICE) $(LIBLTDL)
vartools_DEPENDENCIES = $(LTDLDEPS) libvartoolspipeline.la \
	libvartools.la $(am__append_8) $(am__append_10)
all: all-am

.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu src/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --gnu src/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):
install-binPROGRAMS: $(bin_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(bindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(bindir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	 || test -f $$p1 \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	    echo " $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(bindir)$$dir'"; \
	    $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(bindir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-binPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(bindir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(bindir)" && rm -f $$files

clean-binPROGRAMS:
	@list='$(bin_PROGRAMS)'; test -n "$$list" || exit 0; \
	echo " rm -f" $$list; \
	rm -f $$list || exit $$?; \
	test -n "$(EXEEXT)" || exit 0; \
	list=`for p in $$list; do echo "$$p"; done | sed 's/$(EXEEXT)$$//'`; \
	echo " rm -f" $$list; \
	rm -f $$list

install-libLTLIBRARIES: $(lib_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(lib_LTLIBRARIES)'; test -n "$(libdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(libdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(libdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(libdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(libdir)"; \
	}

uninstall-libLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(lib_LTLIBRARIES)'; test -n "$(libdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(libdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(libdir)/$$f"; \
	done

clean-libLTLIBRARIES:
	-test -z "$(lib_LTLIBRARIES)" || rm -f $(lib_LTLIBRARIES)
	@list='$(lib_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

libvartools.la: $(libvartools_la_OBJECTS) $(libvartools_la_DEPENDENCIES) $(EXTRA_libvartools_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(LINK) -rpath $(libdir) $(libvartools_la_OBJECTS) $(libvartools_la_LIBADD) $(LIBS)

libvartoolspipeline.la: $(libvartoolspipeline_la_OBJECTS) $(libvartoolspipeline_la_DEPENDENCIES) $(EXTRA_libvartoolspipeline_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libvartoolspipeline_la_LINK) -rpath $(libdir) $(libvartoolspipeline_la_OBJECTS) $(libvartoolspipeline_la_LIBADD) $(LIBS)

libvartoolsrunR.la: $(libvartoolsrunR_la_OBJECTS) $(libvartoolsrunR_la_DEPENDENCIES) $(EXTRA_libvartoolsrunR_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(LINK) $(am_libvartoolsrunR_la_rpath) $(libvartoolsrunR_la_OBJECTS) $(libvartoolsrunR_la_LIBADD) $(LIBS)

libvartoolsrunpython.la: $(libvartoolsrunpython_la_OBJECTS) $(libvartoolsrunpython_la_DEPENDENCIES) $(EXTRA_libvartoolsrunpython_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libvartoolsrunpython_la_LINK) $(am_libvartoolsrunpython_la_rpath) $(libvartoolsrunpython_la_OBJECTS) $(libvartoolsrunpython_la_LIBADD) $(LIBS)

vartools$(EXEEXT): $(vartools_OBJECTS) $(vartools_DEPENDENCIES) $(EXTRA_vartools_DEPENDENCIES) 
	@rm -f vartools$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(vartools_OBJECTS) $(vartools_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

